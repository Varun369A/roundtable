generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserTier {
  FREE
  BUILDER   // ₹799/month — user brings own API keys, unlimited tasks
  STUDIO    // ₹1,999/month — Claude Opus synthesis, team workspace
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TaskStatus {
  PENDING
  WAITING_CLARIFICATION  // paused — waiting for user to answer pre-task questions
  ROUTING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum SubtaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

// Discussion Engine — role of a subtask within the multi-round AI collaboration
enum SubtaskRole {
  INITIAL    // Round 1: primary work by assigned AI
  REVIEW     // Round 2: cross-review of another AI's INITIAL output
  SYNTHESIS  // Round 3: final integration of all outputs
}

enum AIModel {
  // ── Core reasoning & code ───────────────────────────────────────────────
  claude_3_5_sonnet   @map("claude-3-5-sonnet")   // Coding
  claude_3_opus       @map("claude-3-opus")         // Deep reasoning
  gpt_4o              @map("gpt-4o")                // Reasoning
  // ── Analysis & research ─────────────────────────────────────────────────
  gemini_2_5_pro      @map("gemini-2.5-pro")        // Analysis / guidance
  perplexity_sonar    @map("perplexity-sonar")      // Research
  // ── Specialised ─────────────────────────────────────────────────────────
  sarvam_1            @map("sarvam-1")              // Indian languages
  elevenlabs          @map("elevenlabs")            // Voice output (TTS)
  whisper             @map("whisper")               // Voice input (STT)
  gpt_image_1         @map("gpt-image-1")           // Image generation
  // ── Arivarangam AI — synthesiser ────────────────────────────────────────
  sabha_ai            @map("sabha-ai")
}

enum TaskCategory {
  research
  copywriting    // legacy — kept for backward compat
  content        // writing, blogs, articles, copy
  strategy
  images         // legacy — kept for backward compat
  image          // image generation
  video
  audio          // legacy — kept for backward compat
  voice          // TTS / audio generation
  presentation
  code
  translation
  data_analysis
  general
}

enum OutputType {
  text
  image
  audio
  video
  file
  json
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  trialing
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceType {
  PERSONAL
  TEAM
  ENTERPRISE
}

enum TemplateCategory {
  development
  design
  learning
  marketing
  business
  content
  research
  personal
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String
  passwordHash  String?     // null if OAuth-only
  tier          UserTier    @default(FREE)
  status        UserStatus  @default(ACTIVE)
  isAdmin       Boolean     @default(false)
  // @deprecated — use isEmailVerified + emailVerifiedAt (lines below). Remove in next migration.
  emailVerified Boolean     @default(false)
  avatarUrl     String?

  // Preferences stored as JSON
  preferences   Json        @default("{}")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastActiveAt  DateTime    @default(now())

  // Free tier task budget — decremented on every Arivarangam-funded task
  freeTasksRemaining Int       @default(3)

  // Founding member — first 200 paying users get locked-in discounted pricing
  foundingMember     Boolean   @default(false)

  // DPDP Act 2023 — India's Digital Personal Data Protection Act.
  // User must explicitly consent before their task data is used to train Arivarangam-AI.
  // Never inferred, never defaulted to true, never coerced.
  trainingConsent    Boolean   @default(false)
  trainingConsentAt  DateTime? // when they gave consent (required for audit)

  // Suspension
  isSuspended        Boolean   @default(false)
  suspendedAt        DateTime?
  suspendedReason    String?

  // Beta access
  betaCode           String?   // the invite code used to sign up
  isBeta             Boolean   @default(false)

  // Onboarding
  onboardingStep     Int       @default(0) // 0=not started, -1=completed

  // Active workspace (personal workspace is auto-created on signup)
  currentWorkspaceId String?

  // Relations
  oauthAccounts    OAuthAccount[]
  refreshTokens    RefreshToken[]
  tasks            Task[]
  subscription     Subscription?
  billingEvents    BillingEvent[]
  usageStats       UsageStats?
  ownedWorkspaces  Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  createdTemplates RoundtableTemplate[] @relation("TemplateCreator")
  codeProjects        CodeProject[]
  gitHubConnection    GitHubConnection?
  aiConnections       UserAIConnection[]
  routingPreferences  UserRoutingPreference[]
  memories            UserMemory[]
  memoryFacts         UserMemoryFact[]
  scheduledTasks      ScheduledTask[]
  workflows           Workflow[]
  integrations        UserIntegration[]
  executionActions    ExecutionAction[]
  voiceTranscriptions VoiceTranscription[]
  creditWallet        CreditWallet?
  referralCode        ReferralCode?
  packSubscriptions   UserPackSubscription[]
  expertProfile       ExpertProfile?
  expertReviewsRequested ExpertReview[]     @relation("ReviewRequester")
  passwordResetTokens    PasswordResetToken[]
  emailVerifications     EmailVerification[]
  dataRequests           DataRequest[]
  isEmailVerified        Boolean              @default(false)
  emailVerifiedAt        DateTime?

  @@index([email])
  @@index([tier])
  @@map("users")
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String   // "google", "github"
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  userAgent   String?
  ipAddress   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Workspaces ───────────────────────────────────────────────────────────────

model Workspace {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  avatarUrl   String?
  type        WorkspaceType @default(PERSONAL)
  ownerId     String

  // JSON: { allowMemberInvite, defaultTaskVisibility, requireApprovalForPublish }
  settings    Json          @default("{\"allowMemberInvite\":false,\"defaultTaskVisibility\":\"private\",\"requireApprovalForPublish\":false}")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  tasks   Task[]

  @@index([ownerId])
  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  invitedBy   String?
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([token])
  @@index([email])
  @@map("workspace_invites")
}

// ─── Roundtable Templates ─────────────────────────────────────────────────────

model RoundtableTemplate {
  id          String           @id @default(cuid())
  name        String
  description String
  category    TemplateCategory
  subcategory String?

  icon        String           // emoji
  color       String           // tailwind color class

  // JSON: Array of TemplateAgent { model, role, instruction, category, dependsOnPrevious }
  agents      Json

  examplePrompts String[]      @default([])
  tags           String[]      @default([])

  useCount    Int              @default(0)
  isBuiltIn   Boolean          @default(true)
  isPublic    Boolean          @default(true)

  createdById String?
  createdBy   User?            @relation("TemplateCreator", fields: [createdById], references: [id])

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tasks       Task[]
  analytics   TemplateAnalytics?

  @@index([category])
  @@index([isBuiltIn, isPublic])
  @@index([createdById])
  @@map("roundtable_templates")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id            String      @id @default(cuid())
  userId        String
  workspaceId   String?     // null = personal (hidden from workspace)
  templateId    String?     // which template was used (if any)
  verticalPackId String?    // which vertical pack was used (if any)
  title         String      // auto-generated short title
  originalGoal  String      // raw user input
  status        TaskStatus  @default(PENDING)
  visibility    String      @default("private") // "private" | "workspace"

  // The context object that travels between AIs — stored as JSON
  contextObject Json        @default("{}")

  // Accumulated cost tracking
  totalCostUsd  Decimal     @default(0) @db.Decimal(10, 6)

  // Abandonment tracking (Fix 19 — funnel analytics + product iteration)
  abandonedAtRound  Int?        // 1, 2, or 3 — which Roundtable round user left at
  abandonedAt       DateTime?   // when client disconnected / user navigated away
  timeToCompleteMs  Int?        // ms from createdAt → completedAt (null if not completed)
  templateUsed      Boolean     @default(false) // was a template used?

  // Metadata
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  completedAt   DateTime?

  // Relations
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?        @relation(fields: [workspaceId], references: [id])
  template       RoundtableTemplate? @relation(fields: [templateId], references: [id])
  verticalPack   VerticalPack?     @relation("TaskVerticalPack", fields: [verticalPackId], references: [id])
  subtasks       Subtask[]
  billingEvents  BillingEvent[]
  codeProject    CodeProject?
  clarifications      TaskClarification[]
  steeringMessages    TaskSteeringMessage[]
  roundtableSession   RoundtableSession?
  executionActions    ExecutionAction[]
  voiceTranscriptions VoiceTranscription[]
  expertReviews       ExpertReview[]
  versions            TaskVersion[]
  corrections         TaskCorrection[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])        // dashboard query: my tasks by status
  @@index([userId, createdAt])     // dashboard query: my tasks sorted by date
  @@index([workspaceId, status])   // workspace task feed
  @@index([templateId])            // template usage analytics
  @@map("tasks")
}

model Subtask {
  id            String        @id @default(cuid())
  taskId        String
  title         String
  category      TaskCategory
  assignedModel AIModel
  status        SubtaskStatus @default(PENDING)

  // DAG — list of subtask IDs this depends on
  dependsOn     String[]      @default([])

  // Discussion Engine: role within multi-round AI collaboration
  role          SubtaskRole   @default(INITIAL)
  roundNumber   Int           @default(1)   // 1=initial, 2=review, 3=synthesis
  reviewsSubtaskId String?    // for REVIEW subtasks: which INITIAL subtask this reviews

  // The prompt sent to the AI (built from context + task-specific instruction)
  inputPrompt   String

  // Execution order within the task
  executionOrder Int          @default(0)

  // Cost
  costUsd       Decimal?      @db.Decimal(10, 6)
  inputTokens   Int?
  outputTokens  Int?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?

  // Relations
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  output           SubtaskOutput?
  verification     SubtaskVerification?
  executionActions ExecutionAction[]

  @@index([taskId])
  @@index([status])
  @@index([taskId, status])        // orchestrator: ready subtasks query
  @@map("subtasks")
}

model SubtaskOutput {
  id          String     @id @default(cuid())
  subtaskId   String     @unique
  type        OutputType
  content     String?    // for text outputs
  fileUrl     String?    // for media outputs
  fileSizeBytes Int?
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@map("subtask_outputs")
}

// ─── AI Models Registry ───────────────────────────────────────────────────────

model AIConnector {
  id              String   @id @default(cuid())
  model           AIModel  @unique
  displayName     String
  provider        String   // "anthropic", "openai", "google", etc.
  description     String
  capabilities    String[] // ["text", "reasoning", "code", "vision"]
  categories      String[] // ["research", "copywriting", ...]

  // Pricing (per 1M tokens or per call)
  inputCostPer1M  Decimal  @db.Decimal(10, 4)
  outputCostPer1M Decimal  @db.Decimal(10, 4)

  // Status
  isActive        Boolean  @default(true)
  isAvailable     Boolean  @default(true) // live availability check

  // Performance metrics (updated by router)
  avgLatencyMs    Int      @default(0)
  successRate     Decimal  @default(1) @db.Decimal(5, 4)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_connectors")
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  status               SubscriptionStatus @default(active)

  // Razorpay IDs
  razorpaySubscriptionId String?          @unique
  razorpayCustomerId     String?

  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)

  // Usage this period
  tasksUsed            Int                @default(0)
  roundtableTasksUsed  Int                @default(0)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model BillingEvent {
  id          String   @id @default(cuid())
  userId      String
  taskId      String?

  // What happened
  eventType   String   // "api_call", "subscription_charge", "refund"
  aiModel     AIModel?

  // Costs
  costUsd     Decimal  @db.Decimal(10, 6)
  inputTokens Int?
  outputTokens Int?

  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([taskId])
  @@index([createdAt])
  @@index([userId, createdAt])     // billing history: user's events by date
  @@index([userId, aiModel])       // analytics: per-user per-model spend
  @@map("billing_events")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  task_completed
  task_failed
  workspace_invite
  weekly_digest
  system_alert
  model_fallback
  healing_applied
  arivarangam_ready
  arivarangam_ai_correction
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  REPO_ACCESS_GRANTED
  REPO_ACCESS_REVOKED
  PRIORITY_REPORT
  ACCOUNT_WARNING
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("notifications")
}

// ─── AI Firewall ──────────────────────────────────────────────────────────────

model FirewallLog {
  id        String   @id @default(cuid())
  userId    String?
  taskId    String?
  threats   Json     // FirewallThreat[]
  riskScore Int
  blocked   Boolean  @default(false)
  context   String   @default("ai_prompt") // user_input | ai_prompt | ai_output
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([blocked])
  @@index([createdAt])
  @@map("firewall_logs")
}

// ─── Template Analytics ───────────────────────────────────────────────────────

model TemplateAnalytics {
  id              String   @id @default(cuid())
  templateId      String   @unique
  weekStart       DateTime
  taskCount       Int      @default(0)
  completionRate  Decimal  @default(0) @db.Decimal(5, 4)
  avgCostUsd      Decimal  @default(0) @db.Decimal(10, 6)
  avgDurationMs   Int      @default(0)
  returnUserRate  Decimal  @default(0) @db.Decimal(5, 4)
  performanceScore Decimal @default(0) @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt

  template RoundtableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([performanceScore])
  @@map("template_analytics")
}

// ─── Healing Log ──────────────────────────────────────────────────────────────

enum HealingAction {
  stale_task_requeued
  dead_letter_retried
  fallback_model_used
  circuit_reset_waited
  permanently_failed
}

model HealingLog {
  id         String        @id @default(cuid())
  action     HealingAction
  taskId     String?
  subtaskId  String?
  fromModel  String?
  toModel    String?
  errorType  String?
  attempt    Int           @default(1)
  success    Boolean       @default(false)
  metadata   Json          @default("{}")
  createdAt  DateTime      @default(now())

  @@index([taskId])
  @@index([action])
  @@index([createdAt])
  @@map("healing_logs")
}

// ─── Developer Sandbox ────────────────────────────────────────────────────────

enum SandboxStatus {
  PENDING
  TESTING
  CONFIRMED
  APPLIED
  REJECTED
}

enum SandboxFixType {
  template_instruction
  rate_limit
  fallback_model
  prompt_adjustment
  feature_flag
}

model SandboxSession {
  id            String         @id @default(cuid())
  title         String
  diagnosis     String         // AI-generated problem description
  proposedFix   Json           // { type: SandboxFixType, target: string, change: any }
  status        SandboxStatus  @default(PENDING)
  runCount      Int            @default(0)
  successCount  Int            @default(0)
  createdById   String
  appliedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  runs          SandboxRun[]

  @@index([status])
  @@index([createdById])
  @@map("sandbox_sessions")
}

model SandboxRun {
  id          String   @id @default(cuid())
  sessionId   String
  runNumber   Int
  passed      Boolean
  output      Json     @default("{}")  // test task result summary
  errorMsg    String?
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  session SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("sandbox_runs")
}

// ─── Code Workspace ───────────────────────────────────────────────────────────

enum CodeProjectStatus {
  ASSEMBLING
  READY
  FAILED
}

model CodeProject {
  id        String            @id @default(cuid())
  taskId    String            @unique
  userId    String
  name      String            // derived from task title
  files     Json              // CodeFile[] { path, content, language }
  status    CodeProjectStatus @default(ASSEMBLING)
  zipUrl    String?           // R2/local URL after ZIP generation
  repoUrl   String?           // GitHub repo URL if pushed
  pushedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  task    Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])
  envVars ProjectEnvVar[]

  @@index([userId])
  @@index([status])
  @@map("code_projects")
}

model GitHubConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String
  login       String   // GitHub username
  githubId    Int
  avatarUrl   String?
  scopes      String   @default("repo")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}

// ─── Beta Invites ─────────────────────────────────────────────────────────────

model BetaInvite {
  id          String    @id @default(cuid())
  code        String    @unique  // e.g. "SABHA-LAUNCH-X7K2"
  email       String?             // optional: pre-assign to an email
  note        String?             // internal note (who is this for)
  usedById    String?
  usedAt      DateTime?
  createdById String             // admin who generated it
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([code])
  @@index([usedById])
  @@map("beta_invites")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

enum FeedbackType {
  bug
  feature_request
  general
  praise
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String?
  type      FeedbackType @default(general)
  message   String
  rating    Int?          // 1–5 if provided
  page      String?       // current URL path
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("feedback")
}

// ─── Feature Flags ────────────────────────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique   // e.g. "new_dashboard", "team_workspaces"
  enabled     Boolean  @default(false)
  // JSON: { allowlist: string[] (userIds), rolloutPercent: number 0-100 }
  config      Json     @default("{}")
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("feature_flags")
}

// ─── Usage Stats ──────────────────────────────────────────────────────────────

model UsageStats {
  id                    String   @id @default(cuid())
  userId                String   @unique
  totalTasksCreated     Int      @default(0)
  totalTasksCompleted   Int      @default(0)
  totalSubtasksRun      Int      @default(0)
  totalCostUsd          Decimal  @default(0) @db.Decimal(10, 4)
  totalTokensUsed       Int      @default(0)
  favoriteModel         AIModel?
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_stats")
}

// ─── Arivarangam AI (Self-Learning) ─────────────────────────────────────────────────

enum ArivarangamAIStatus {
  LEARNING  // accumulating knowledge, silent
  READY     // enough knowledge, awaiting admin enablement
  ENABLED   // live and handling tasks
  DISABLED  // admin disabled
}

// How independently Arivarangam operates for a given domain
enum LearningStage {
  STUDENT      // follows all specialist guidance (< 40 confidence)
  ADVISORY     // reasons first, uses specialists to verify (40–74)
  INDEPENDENT  // leads the work, specialists confirm edge cases (≥ 75)
}

// Full task-chain training record — the brain data
model ArivarangamKnowledge {
  id               String       @id @default(cuid())
  category         TaskCategory
  templateCategory String?
  inputSummary     String       // goal (first 500 chars)
  outputSummary    String       // synthesis output (first 3000 chars)
  specialistContext Json?        // full specialist chain: [{model, role, output}]
  specialistsUsed  String[]     @default([])  // list of model names used
  complexityLevel  String?      // simple | standard | complex
  model            AIModel      // always sabha_ai for synthesis records
  qualityScore     Float        @default(0.5)
  isFineTuneReady  Boolean      @default(false)
  exportedAt       DateTime?
  taskId           String
  subtaskId        String       @unique
  createdAt        DateTime     @default(now())

  @@index([category])
  @@index([qualityScore])
  @@index([isFineTuneReady])
  @@map("arivarangam_knowledge")
}

// Per-domain confidence — drives stage transitions
model DomainConfidence {
  id                 String        @id @default(cuid())
  category           TaskCategory  @unique
  totalSamples       Int           @default(0)
  highQualitySamples Int           @default(0)   // score >= 0.7
  avgQualityScore    Float         @default(0.0)
  confidenceScore    Float         @default(0.0)  // 0–100 composite
  stage              LearningStage @default(STUDENT)
  lastUpdatedAt      DateTime      @default(now())

  @@map("domain_confidence")
}

// Audit log for each fine-tune export
model FineTuneExport {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  sampleCount Int
  categories  String[]
  minQuality  Float
  status      String   @default("pending")  // pending | completed | failed
  triggeredBy String?  // admin userId
  notes       String?

  @@map("fine_tune_exports")
}

model ArivarangamAIState {
  id              String        @id @default("singleton")
  status          ArivarangamAIStatus @default(LEARNING)
  knowledgeCount  Int           @default(0)
  readyThreshold  Int           @default(50)
  enabledAt       DateTime?
  lastLearnedAt   DateTime?
  updatedAt       DateTime      @updatedAt

  @@map("arivarangam_ai_state")
}

// ─── Project Environment Variables ───────────────────────────────────────────

model ProjectEnvVar {
  id             String      @id @default(cuid())
  projectId      String
  name           String      // variable name e.g. DATABASE_URL
  encryptedValue String      // AES-256-GCM encrypted value
  iv             String      // initialization vector (hex)
  authTag        String      // GCM auth tag (hex)
  hint           String?     // optional hint e.g. "postgres connection string"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("project_env_vars")
}

// ─── BYOAI — Bring Your Own AI ────────────────────────────────────────────────

model UserAIConnection {
  id             String   @id @default(cuid())
  userId         String
  provider       String   // matches ProviderDef.key e.g. "anthropic", "openai"
  displayName    String?  // user-visible label
  encryptedKey   String   // AES-256-GCM encrypted API key
  salt           String?  // scrypt salt for per-user key derivation (hex, 32 bytes)
  iv             String   // GCM IV (hex)
  authTag        String   // GCM auth tag (hex)
  isVerified     Boolean   @default(false) // key passed test call
  verifiedAt     DateTime?               // timestamp of last successful verification
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_ai_connections")
}

// ─── User Routing Preferences ─────────────────────────────────────────────────

model UserRoutingPreference {
  id           String       @id @default(cuid())
  userId       String
  taskCategory TaskCategory
  preferredModel AIModel
  priority     Int          @default(0)  // higher = shown first in UI
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskCategory])
  @@index([userId])
  @@map("user_routing_preferences")
}

// ─── Phase 1: Clarification Round ────────────────────────────────────────────

model TaskClarification {
  id         String    @id @default(cuid())
  taskId     String
  question   String
  orderIndex Int       @default(0)
  answer     String?
  answeredAt DateTime?
  skipped    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_clarifications")
}

// ─── Phase 1: User Memory ─────────────────────────────────────────────────────

model UserMemory {
  id          String   @id @default(cuid())
  userId      String
  category    String   // "business" | "preferences" | "audience" | "tone" | "technical" | "personal"
  key         String   // e.g. "business_type", "target_audience", "writing_tone"
  value       String   // stored value (text)
  source      String   @default("user_set") // "user_set" | "inferred" | "onboarding"
  confidence  Float    @default(1.0)    // 0-1; inferred facts can decay
  usageCount  Int      @default(0)      // times injected into prompts
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, isActive])
  @@map("user_memories")
}

model UserMemoryFact {
  id           String   @id @default(cuid())
  userId       String
  fact         String   // extracted factual statement about the user/business
  category     String
  confidence   Float    @default(0.7)
  sourceTaskId String?  // which task triggered inference
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_memory_facts")
}

// ─── Phase 1: Mid-Generation Steering ────────────────────────────────────────

model TaskSteeringMessage {
  id                 String    @id @default(cuid())
  taskId             String
  userId             String
  message            String    // user's steering instruction
  appliedToSubtaskId String?   // which subtask picked this up
  appliedAt          DateTime?
  priority           Int       @default(0) // higher = applied first
  createdAt          DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, appliedAt])
  @@map("task_steering_messages")
}

// ─── Phase 1: Scheduled Tasks ─────────────────────────────────────────────────

model ScheduledTask {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String?
  name           String
  goal           String    // supports {{variable}} interpolation
  templateId     String?
  cronExpression String    // standard cron: "0 9 * * 1"
  timezone       String    @default("Asia/Kolkata")
  isActive       Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  runCount       Int       @default(0)
  failCount      Int       @default(0)
  maxRuns        Int?      // null = unlimited
  notifyOnFail   Boolean   @default(true)
  notifyOnComplete Boolean @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs ScheduledTaskRun[]

  @@index([userId])
  @@index([isActive, nextRunAt]) // cron worker query
  @@map("scheduled_tasks")
}

model ScheduledTaskRun {
  id              String    @id @default(cuid())
  scheduledTaskId String
  taskId          String?   // the Task created for this run
  status          String    // "running" | "completed" | "failed" | "skipped"
  triggerType     String    @default("scheduled") // "scheduled" | "manual"
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  errorMessage    String?

  scheduledTask ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@index([taskId])
  @@map("scheduled_task_runs")
}

// ─── Phase 2: Multiplayer Roundtable ─────────────────────────────────────────

model RoundtableSession {
  id          String    @id @default(cuid())
  taskId      String    @unique
  ownerId     String
  accessCode  String    @unique  // 6-char alphanumeric share code
  isPublic    Boolean   @default(false)
  allowSteering Boolean @default(false)  // can non-owners send steering?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  task         Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  participants RoundtableParticipant[]
  reactions    RoundtableReaction[]

  @@index([accessCode])
  @@index([ownerId])
  @@map("roundtable_sessions")
}

model RoundtableParticipant {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String?  // null = guest
  displayName String
  avatarUrl   String?
  role        String   @default("viewer") // "owner" | "collaborator" | "viewer"
  isOnline    Boolean  @default(false)
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  session RoundtableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("roundtable_participants")
}

model RoundtableReaction {
  id         String   @id @default(cuid())
  sessionId  String
  subtaskId  String?
  userId     String?
  reaction   String   // emoji: "👍" "🔥" "✨" "❓" "👎"
  createdAt  DateTime @default(now())

  session RoundtableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, subtaskId])
  @@map("roundtable_reactions")
}

// ─── Phase 2: Workflow Builder ────────────────────────────────────────────────

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Workflow {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  triggerType String        @default("manual") // "manual" | "scheduled" | "webhook"
  webhookSecret String?     // for webhook trigger validation
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps WorkflowStep[]
  runs  WorkflowRun[]

  @@index([userId])
  @@index([status])
  @@map("workflows")
}

model WorkflowStep {
  id             String  @id @default(cuid())
  workflowId     String
  stepOrder      Int
  name           String
  templateId     String?
  goalTemplate   String  // supports {{step1.output}} {{trigger.payload}} interpolation
  assignedModel  String? // override model for this step (optional)
  dependsOnStepId String? // for non-sequential steps

  // Output mapping — extract named values from output for next steps
  // e.g. { "research_summary": "extract key findings" }
  outputMapping  Json    @default("{}")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, stepOrder])
  @@map("workflow_steps")
}

model WorkflowRun {
  id          String           @id @default(cuid())
  workflowId  String
  status      WorkflowRunStatus @default(RUNNING)
  triggerType String           @default("manual")
  triggerPayload Json          @default("{}")  // webhook body / manual params
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  errorMessage String?

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns  WorkflowStepRun[]

  @@index([workflowId])
  @@map("workflow_runs")
}

model WorkflowStepRun {
  id         String  @id @default(cuid())
  runId      String
  stepId     String
  taskId     String? // the Arivarangam Task created for this step
  status     String  // "pending" | "running" | "completed" | "failed" | "skipped"
  output     Json    @default("{}")  // extracted output values from output mapping
  startedAt  DateTime @default(now())
  completedAt DateTime?
  errorMessage String?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([taskId])
  @@map("workflow_step_runs")
}

// ─── Phase 3: Output Quality Verification ─────────────────────────────────────

enum VerificationStatus {
  PENDING
  RUNNING
  PASSED
  PARTIAL
  FAILED
}

model SubtaskVerification {
  id              String             @id @default(cuid())
  subtaskId       String             @unique
  status          VerificationStatus @default(PENDING)
  confidenceScore Float              @default(0)  // 0.0–1.0 overall quality
  factualScore    Float              @default(0)  // factual accuracy estimate
  completenessScore Float            @default(0)  // covers all requirements
  citationsFound  Int                @default(0)  // number of citations extracted
  issues          Json               @default("[]") // [{ type, severity, description, suggestion }]
  citations       Json               @default("[]") // [{ text, source, url?, confidence }]
  verifiedAt      DateTime?
  verifiedBy      String?            // model used for verification

  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@map("subtask_verifications")
}

// ─── Phase 3: Agent Execution (External Actions) ──────────────────────────────

enum ActionStatus {
  PENDING_APPROVAL  // waiting for user to approve
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
  EXPIRED           // approval window passed
}

enum ActionType {
  GITHUB_PUSH       // push code changes to a repository
  GITHUB_PR         // create a pull request
  GITHUB_ISSUE      // create an issue
  GMAIL_SEND        // send email
  GMAIL_DRAFT       // save draft
  NOTION_PAGE       // create/update Notion page
  NOTION_DB_ROW     // add row to Notion database
  WEBHOOK           // call arbitrary webhook
  SLACK_MESSAGE     // post to Slack channel
}

model ExecutionAction {
  id              String       @id @default(cuid())
  subtaskId       String
  taskId          String
  userId          String
  type            ActionType
  status          ActionStatus @default(PENDING_APPROVAL)
  integrationId   String?      // UserIntegration that will execute this
  payload         Json         // action-specific payload (repo, branch, content, etc.)
  result          Json?        // execution result
  requiresApproval Boolean     @default(true)
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedReason  String?
  executedAt      DateTime?
  expiresAt       DateTime?    // auto-expire if not approved
  errorMessage    String?
  createdAt       DateTime     @default(now())

  subtask     Subtask  @relation(fields: [subtaskId], references: [id])
  task        Task     @relation(fields: [taskId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  integration UserIntegration? @relation(fields: [integrationId], references: [id])

  @@index([subtaskId])
  @@index([taskId])
  @@index([userId, status])
  @@map("execution_actions")
}

// ─── Phase 3: User Integrations ───────────────────────────────────────────────

enum IntegrationProvider {
  GITHUB
  GMAIL
  NOTION
  SLACK
  JIRA
  LINEAR
  WEBHOOK
}

model UserIntegration {
  id              String              @id @default(cuid())
  userId          String
  provider        IntegrationProvider
  displayName     String              // e.g. "work-github", "personal-gmail"
  isActive        Boolean             @default(true)
  encryptedToken  String              // AES-256-GCM encrypted access token
  tokenIv         String
  tokenAuthTag    String
  refreshToken    String?             // encrypted, for OAuth refresh
  refreshIv       String?
  refreshAuthTag  String?
  tokenExpiresAt  DateTime?
  scopes          String[]            @default([])
  metadata        Json                @default("{}")  // provider-specific config
  connectedAt     DateTime            @default(now())
  lastUsedAt      DateTime?

  user    User              @relation(fields: [userId], references: [id])
  actions ExecutionAction[]

  @@unique([userId, provider, displayName])
  @@index([userId, provider])
  @@map("user_integrations")
}

// ─── Phase 3: Voice Input ────────────────────────────────────────────────────

model VoiceTranscription {
  id            String   @id @default(cuid())
  userId        String
  taskId        String?  // if linked to a task
  provider      String   // "whisper" | "sarvam"
  language      String   @default("en")  // ISO 639-1 language code
  durationSecs  Float
  originalText  String   @db.Text  // raw transcription
  processedText String   @db.Text  // cleaned up / punctuated
  confidence    Float    @default(1.0)
  audioFileUrl  String?  // stored in object storage
  createdAt     DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([taskId])
  @@map("voice_transcriptions")
}

// ─── Phase 4: Credit Economy Enhancement ──────────────────────────────────────

enum CreditTransactionType {
  PURCHASE          // bought credits via Razorpay
  TASK_USAGE        // credits spent on a task
  REFERRAL_BONUS    // earned by referring a new user
  REFERRAL_REWARD   // earned when referred user completes first task
  SIGNUP_BONUS      // new user welcome credits
  PROMOTION         // admin-issued promotional credits
  EXPIRY            // expired credits deducted
  REFUND            // refund from failed task
  MARKETPLACE_EARN  // earned by expert review completion
}

model CreditWallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balance      Int      @default(0)    // current spendable credits
  lifetimeEarned Int    @default(0)    // total credits ever earned
  lifetimeSpent  Int    @default(0)    // total credits ever spent
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions CreditTransaction[]

  @@map("credit_wallets")
}

model CreditTransaction {
  id           String                @id @default(cuid())
  walletId     String
  userId       String
  type         CreditTransactionType
  amount       Int                   // positive = credit, negative = debit
  balanceAfter Int                   // wallet balance after this transaction
  description  String
  taskId       String?               // for TASK_USAGE / REFUND
  referralId   String?               // for REFERRAL_* types
  expiresAt    DateTime?             // for PROMOTION credits that expire
  createdAt    DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([userId, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

model ReferralCode {
  id           String    @id @default(cuid())
  userId       String    @unique
  code         String    @unique   // e.g. "ARYAN50"
  usageCount   Int       @default(0)
  maxUses      Int?                // null = unlimited
  bonusCredits Int       @default(100) // credits referrer earns per signup
  rewardCredits Int      @default(50)  // credits referee earns on first task
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  user     User       @relation(fields: [userId], references: [id])
  referrals Referral[]

  @@map("referral_codes")
}

model Referral {
  id             String    @id @default(cuid())
  referralCodeId String
  referrerId     String    // who referred
  refereeId      String    // who was referred
  bonusPaid      Boolean   @default(false)  // referrer got their bonus
  rewardPaid     Boolean   @default(false)  // referee got their reward
  firstTaskAt    DateTime?
  createdAt      DateTime  @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id])

  @@unique([refereeId])  // one referral per user
  @@index([referrerId])
  @@map("referrals")
}

model CreditPack {
  id           String   @id @default(cuid())
  name         String   // "Starter Pack", "Pro Pack", "Power Pack"
  credits      Int      // credits included
  priceInr     Int      // price in INR paise (e.g. 49900 = ₹499)
  bonusCredits Int      @default(0) // bonus on top
  isActive     Boolean  @default(true)
  isPopular    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("credit_packs")
}

// ─── Phase 4: Human Expert Review Marketplace ─────────────────────────────────

enum ExpertStatus {
  PENDING_REVIEW    // applied, not yet approved
  ACTIVE
  SUSPENDED
  RETIRED
}

enum ReviewRequestStatus {
  OPEN              // waiting for expert to claim
  IN_REVIEW         // expert claimed, reviewing
  SUBMITTED         // expert submitted review
  ACCEPTED          // user accepted the review
  DISPUTED          // user disputed
  REFUNDED          // refunded to user
  EXPIRED           // no expert claimed within 24h
}

model ExpertProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  bio           String       @db.Text
  specializations String[]   // ["legal", "medical", "finance", "code", "content"]
  languages     String[]     @default(["en"])
  credentialsUrl String?     // CV / LinkedIn / portfolio
  ratePerReview Int          // credits per review
  avgRating     Float        @default(0)
  reviewCount   Int          @default(0)
  status        ExpertStatus @default(PENDING_REVIEW)
  isAvailable   Boolean      @default(true)
  approvedAt    DateTime?
  approvedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  reviews ExpertReview[]

  @@index([status, isAvailable])
  @@index([specializations])
  @@map("expert_profiles")
}

model ExpertReview {
  id            String              @id @default(cuid())
  taskId        String
  userId        String              // user who requested review
  expertId      String              // ExpertProfile.id
  status        ReviewRequestStatus @default(OPEN)
  specialization String             // what domain expertise needed
  description   String?             // what specifically to review
  creditsEscrowed Int               // credits locked from user wallet
  claimedAt     DateTime?
  submittedAt   DateTime?
  expiresAt     DateTime            // 24h after creation
  feedback      String?             @db.Text
  rating        Int?                // 1-5, user rates expert
  ratingComment String?

  task   Task          @relation(fields: [taskId], references: [id])
  user   User          @relation("ReviewRequester", fields: [userId], references: [id])
  expert ExpertProfile @relation(fields: [expertId], references: [id])

  @@index([status])
  @@index([expertId, status])
  @@index([userId])
  @@map("expert_reviews")
}

// ─── Phase 4: Vertical AI Packs ───────────────────────────────────────────────

enum PackCategory {
  LEGAL
  MEDICAL
  FINANCE
  ENGINEERING
  MARKETING
  EDUCATION
  REAL_ESTATE
  HR
}

enum PackStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

model VerticalPack {
  id          String      @id @default(cuid())
  slug        String      @unique  // "legal-pack", "medical-pack"
  name        String               // "Legal AI Pack"
  description String      @db.Text
  category    PackCategory
  icon        String               // emoji
  color       String               // tailwind gradient class
  status      PackStatus  @default(ACTIVE)

  // Pack-specific AI configuration
  agents      Json        // Array of PackAgent { model, role, systemPrompt, category }
  // Pack-specific terminology/context injected into every task
  contextBlob Json        @default("{}")
  // Compliance notes shown to user
  disclaimer  String?     @db.Text

  // Pricing
  isIncludedInTier String[] @default([])  // ["PRO", "POWER", "ENTERPRISE"]
  creditsPerTask  Int      @default(0)    // 0 = included in plan

  usageCount  Int         @default(0)
  isBuiltIn   Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tasks            Task[]                 @relation("TaskVerticalPack")
  userSubscriptions UserPackSubscription[]

  @@map("vertical_packs")
}

model UserPackSubscription {
  id       String   @id @default(cuid())
  userId   String
  packId   String
  isActive Boolean  @default(true)
  enabledAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id])
  pack VerticalPack @relation(fields: [packId], references: [id])

  @@unique([userId, packId])
  @@map("user_pack_subscriptions")
}

// ─── Launch Readiness: Auth & Compliance ──────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique  // SHA-256 of the raw token (never store raw)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// ─── Launch Readiness: Webhook Idempotency ────────────────────────────────────

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   // "razorpay" | "github" | "slack"
  eventId     String   // provider's event ID
  eventType   String
  processedAt DateTime @default(now())
  payload     Json     @default("{}")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ─── Launch Readiness: GDPR Data Requests ─────────────────────────────────────

enum DataRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DataRequestType {
  EXPORT
  DELETION
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  downloadUrl String?           // signed URL for export zip
  expiresAt   DateTime?         // download link expires after 7 days
  completedAt DateTime?
  errorMessage String?
  requestedAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("data_requests")
}

// ─── Spec: Provider Spending Limits ──────────────────────────────────────────

model UserProviderLimit {
  id        String @id @default(cuid())
  userId    String
  provider  String  // "openai" | "anthropic" | "google" | "perplexity" | etc.
  limitInr  Float   // monthly spend ceiling set by user
  warningAt Float   // warning fires at this threshold (e.g. 0.8 × limitInr)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_provider_limits")
}

// ─── Spec: Build Version History ─────────────────────────────────────────────

model BuildVersion {
  id            String   @id @default(cuid())
  taskId        String
  userId        String
  versionNumber Int
  description   String   // e.g. "Initial build", "Dark mode + login fix"
  githubCommit  String?  // commit SHA if auto-push was enabled
  createdAt     DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@map("build_versions")
}

// ─── Task Versioning & Corrections ───────────────────────────────────────────
// Build version snapshot — created after initial completion and each correction.

model TaskVersion {
  id            String   @id @default(cuid())
  taskId        String
  versionNumber Int
  description   String                          // "Initial build" | "Correction: <desc>"
  snapshot      Json                            // { subtaskId: { content, model, role, title } }
  githubCommit  String?                         // commit SHA if auto-pushed
  createdAt     DateTime @default(now())

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  corrections TaskCorrection[]

  @@unique([taskId, versionNumber])
  @@index([taskId])
  @@map("task_versions")
}

// User-submitted correction request — mini-roundtable re-run of affected subtasks.
model TaskCorrection {
  id                 String    @id @default(cuid())
  taskId             String
  userId             String
  description        String    @db.Text          // User's natural language correction
  affectedCategories String[]                    // TaskCategory values that were re-run
  status             String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED
  resultVersionId    String?                     // TaskVersion created after this correction
  githubCommitUrl    String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resultVersion TaskVersion? @relation(fields: [resultVersionId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("task_corrections")
}

// ─── Spec: Arivarangam-AI Training Pipeline (internal only — zero user-facing refs) ─

model ArivarangamAITrainingRecord {
  id                 String   @id @default(cuid())
  taskId             String   @unique
  goal               String
  intentParse        Json
  round1Outputs      Json
  round2Reviews      Json
  deduplicatedReview String
  finalSynthesis     String
  qualityScore       Float?   // 0-10 computed 30 min post-completion
  userDownloaded     Boolean  @default(false)
  userRequestedFix   Boolean  @default(false)
  userRating         Int?
  usedForTraining    Boolean  @default(false)
  createdAt          DateTime @default(now())
  // No userId — privacy-safe by design. No PII stored in training data.

  @@index([qualityScore])
  @@index([usedForTraining])
  @@map("arivarangam_ai_training_records")
}

// ─── UPI Prepaid Credit Purchases ─────────────────────────────────────────────
// Bridge for Indian users without international credit cards.
// UPI payment → Razorpay webhook → credits deposited to CreditWallet.

enum UpiPaymentStatus {
  PENDING    // order created, awaiting payment
  PAID       // Razorpay confirmed payment
  CREDITED   // credits deposited to wallet (idempotency: only once)
  FAILED     // payment failed / expired
  REFUNDED
}

model UpiPayment {
  id                 String           @id @default(cuid())
  userId             String
  creditPackId       String           // which CreditPack was purchased
  razorpayOrderId    String           @unique  // from Razorpay order creation
  razorpayPaymentId  String?          // populated after successful payment
  amountInrPaise     Int              // amount charged (paise, e.g. 49900 = ₹499)
  creditsGranted     Int              // credits including bonus
  status             UpiPaymentStatus @default(PENDING)
  webhookReceivedAt  DateTime?
  creditedAt         DateTime?        // when credits were deposited
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("upi_payments")
}

