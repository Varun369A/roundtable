# Database
DATABASE_URL="postgresql://sabha:sabha_dev@localhost:5432/sabha_db"
DATABASE_POOL_SIZE=20  # Connections per process; coordinate with PgBouncer in prod

# Valkey (drop-in Redis-compatible open-source — https://valkey.io)
VALKEY_URL="valkey://localhost:6379"
REDIS_URL="redis://localhost:6379"  # legacy fallback — prefer VALKEY_URL

# JWT
JWT_SECRET="change-this-to-a-long-random-string-minimum-64-chars"
JWT_REFRESH_SECRET="change-this-to-another-long-random-string-minimum-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# API
PORT=3001
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# AI API Keys (add as you get them)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
GOOGLE_AI_API_KEY=""
ELEVENLABS_API_KEY=""
STABILITY_API_KEY=""
RUNWAY_API_KEY=""
SARVAM_API_KEY=""
MIDJOURNEY_API_KEY=""
MIDJOURNEY_API_URL=""
GROQ_API_KEY=""
COHERE_API_KEY=""

# Storage
STORAGE_PROVIDER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_PRO=""
RAZORPAY_PLAN_POWER=""
RAZORPAY_PLAN_ENTERPRISE=""

# Admin
ADMIN_SECRET="change-this-to-a-strong-random-secret"
ADMIN_EMAIL="admin@sabhaai.com"
ADMIN_PASSWORD="change-this-strong-password"

# Email (Resend)
RESEND_API_KEY=""           # Get from resend.com — free tier: 3000 emails/month
EMAIL_FROM="Sabha <no-reply@sabhaai.com>"  # Must be a verified domain in Resend

# App URLs (used in email links)
NEXT_PUBLIC_APP_URL="https://sabhaai.com"  # public-facing URL for frontend links
NEXT_PUBLIC_API_URL="http://localhost:3001" # API base URL for frontend SSE connections

# AI Firewall
FIREWALL_BLOCK_SCORE=80     # Risk score threshold to block (0-100). Default: 80
FIREWALL_LOG_ALL=false      # Log every firewall check to DB (verbose). Default: false (log threats only)

# NOVA Admin Assistant
# Uses ANTHROPIC_API_KEY (already configured above)

# GitHub OAuth (for Code Workspace → Push to GitHub)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: https://sabhaai.com
# Authorization callback URL: https://sabhaai.com/api/v1/github/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3001/api/v1/github/auth/callback"  # Change for prod

# Environment Variable Encryption (for Project Env Vars feature)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENV_VAR_ENCRYPTION_KEY=""  # 32-byte hex string (64 hex chars). Required in production.

# BYOAI Key Encryption (encrypts user-connected API keys at rest)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BYOAI_KEY_ENCRYPTION_KEY=""  # Separate 32-byte hex — do NOT reuse ENV_VAR_ENCRYPTION_KEY.

# Sabha AI
# No extra keys needed — Sabha AI uses ANTHROPIC_API_KEY as its backbone.
# Enable/disable via Admin → Sabha AI panel once learning threshold is reached.

# Discussion Engine
# No extra config needed — uses existing AI connectors for all 3 rounds.
# Synthesis (Round 3) uses claude-opus, or sabha-ai if enabled by admin.

# AWS (for secrets manager in production)
AWS_REGION="ap-south-1"

# ─── Phase 3: Agent Execution Integrations ────────────────────────────────────
# GitHub OAuth App (for GITHUB_PUSH, GITHUB_PR, GITHUB_ISSUE actions)
# Already configured above (GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET)

# Google OAuth (for GMAIL_SEND, GMAIL_DRAFT actions)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Notion Integration (for NOTION_PAGE, NOTION_DB_ROW actions)
# Internal integration token for server-side; users connect via OAuth
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# Slack App (for SLACK_MESSAGE actions)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

# ─── Phase 4: Razorpay (Credit Economy) ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
