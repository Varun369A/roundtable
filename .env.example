# ─── Arivarangam — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All keys below are EXAMPLES — never commit actual secrets.
# Generate fresh keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://sabha:sabha_dev@localhost:5432/sabha_db"
DATABASE_POOL_SIZE=20  # Connections per process; coordinate with PgBouncer in prod

# ─── Valkey / Redis ────────────────────────────────────────────────────────────
VALKEY_URL="valkey://localhost:6379"
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-96-char-hex-string-minimum-32-chars-required"
JWT_REFRESH_SECRET="replace-with-different-96-char-hex-string-minimum-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── Admin ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET="replace-with-48-char-hex-string"
ADMIN_EMAIL="admin@arivarangam.com"
ADMIN_PASSWORD="replace-with-strong-password-min-12-chars"

# ─── Encryption Keys ──────────────────────────────────────────────────────────
# All keys must be 32 bytes = 64 hex characters.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Each key must be DIFFERENT. Never reuse keys across purposes.

# Key vault master key — per-user scrypt derivation for BYOAI API key encryption
# Required in production. KMS path available for zero-trust setup (see KMS section below).
VAULT_MASTER_KEY="replace-with-64-char-hex-string"

# Social media credential encryption (LinkedIn/Twitter/Instagram OAuth tokens)
SOCIAL_CREDENTIALS_KEY="replace-with-different-64-char-hex-string"

# Project environment variable encryption (Code Workspace feature)
ENV_VAR_ENCRYPTION_KEY="replace-with-different-64-char-hex-string"

# BYOAI legacy encryption key (used by older encrypt helper, kept for migration)
BYOAI_KEY_ENCRYPTION_KEY="replace-with-different-64-char-hex-string"

# ─── AI API Keys (add as you get them — all optional in dev) ──────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
GOOGLE_AI_API_KEY=""
ELEVENLABS_API_KEY=""
STABILITY_API_KEY=""
RUNWAY_API_KEY=""
SARVAM_API_KEY=""
MIDJOURNEY_API_KEY=""
MIDJOURNEY_API_URL=""
GROQ_API_KEY=""
COHERE_API_KEY=""

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"  # "local" or "r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─── Razorpay (Payments) ──────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys in development, rzp_live_* in production
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Plan IDs from Razorpay dashboard (Settings → Subscriptions → Plans)
RAZORPAY_PLAN_BUILDER=""           # ₹799/month
RAZORPAY_PLAN_BUILDER_ANNUAL=""    # ₹638/month billed annually
RAZORPAY_PLAN_STUDIO=""            # ₹1,999/month
RAZORPAY_PLAN_STUDIO_ANNUAL=""     # ₹1,599/month billed annually
RAZORPAY_PLAN_ENTERPRISE=""        # ₹4,999/month
RAZORPAY_PLAN_ENTERPRISE_ANNUAL="" # ₹3,999/month billed annually
RAZORPAY_PLAN_BUILDER_FOUNDING=""  # ₹499/month locked for first 200 users
RAZORPAY_PLAN_STUDIO_FOUNDING=""   # ₹999/month locked for first 200 users

# ─── Currency ─────────────────────────────────────────────────────────────────
# Approximate INR→USD rate for billing event logging only (not used for actual payments).
# Update periodically to reflect current exchange rate.
EXCHANGE_RATE_INR_USD=84

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from: https://resend.com — free tier: 3000 emails/month
RESEND_API_KEY=""
EMAIL_FROM="Arivarangam <no-reply@arivarangam.com>"  # Must be a verified domain in Resend

# ─── GitHub OAuth (Code Workspace → Push to GitHub) ───────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: https://arivarangam.com
# Authorization callback URL: https://arivarangam.com/api/v1/github/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3001/api/v1/github/auth/callback"

# ─── Google OAuth (Gmail / Google Drive integrations) ─────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Notion Integration ────────────────────────────────────────────────────────
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# ─── Slack App ────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# ─── Social Media OAuth (Arivarangam self-marketing automation) ─────────────────────
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3001/api/v1/social/auth/linkedin/callback"
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_REDIRECT_URI="http://localhost:3001/api/v1/social/auth/twitter/callback"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Push Notifications (VAPID) ───────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
ADMIN_PUSH_ENDPOINT=""

# ─── AI Firewall ──────────────────────────────────────────────────────────────
FIREWALL_BLOCK_SCORE=80    # Block threshold 0-100. Default: 80 (high confidence threats only)
FIREWALL_LOG_ALL=false     # Log every check (verbose). Default: false (threats only)

# ─── Analytics & SEO ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_SERVICE_NAME="arivarangam-api"
OTEL_EXPORTER_OTLP_ENDPOINT=""   # e.g. https://api.honeycomb.io or http://tempo:4318
OTEL_EXPORTER_OTLP_HEADERS=""    # e.g. x-honeycomb-team=your-api-key
GRAFANA_ADMIN_PASSWORD="arivarangam_grafana_dev"  # Change before any public access

# ─── AWS (production only — KMS for zero-trust key management) ────────────────
# Leave empty in development — VAULT_MASTER_KEY plaintext fallback is used.
# Production setup:
#   1. Create KMS symmetric key in ap-south-1
#   2. Run: aws kms encrypt --key-id <key-arn> --plaintext fileb://<(echo -n "$VAULT_MASTER_KEY") --output text --query CiphertextBlob
#   3. Set ENCRYPTED_MASTER_KEY to the base64 output
AWS_REGION="ap-south-1"
ENCRYPTED_MASTER_KEY=""   # base64 KMS-encrypted VAULT_MASTER_KEY — production only
KMS_KEY_ID=""             # arn:aws:kms:ap-south-1:ACCOUNT:key/KEY-ID — production only

# ─── PgBouncer (production connection pooling) ────────────────────────────────
# In production, connect through PgBouncer on port 5433:
# DATABASE_URL="postgresql://sabha:PASSWORD@localhost:5433/sabha_db?pgbouncer=true"
